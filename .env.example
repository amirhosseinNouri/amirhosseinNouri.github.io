# Clerk (https://dashboard.clerk.com → API keys)
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=

# Neon Postgres — pooled URL for the app, unpooled URL for drizzle-kit migrations.
# On Vercel these come from the Neon integration as DATABASE_URL /
# DATABASE_URL_UNPOOLED, so they are only needed locally.
NUXT_DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Only this (verified) email may use /admin
NUXT_ADMIN_EMAIL=

# Public origin of the site (canonical URLs, sitemap)
NUXT_SITE_URL=
